{
  "components": {
    "schemas": {
      "ErrorCode": {
        "description": "Códigos estables: el cliente programa contra ellos, no contra el texto.",
        "enum": [
          "invalid_json",
          "validation_error",
          "not_found",
          "method_not_allowed",
          "http_error",
          "model_unavailable",
          "internal_error"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "ErrorDetail": {
        "description": "Descripción estable del error.",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "fields": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Solo presente en errores de validación.",
            "title": "Fields"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "Sobre común de todas las respuestas de error (contrato de S7).",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "error",
          "request_id"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "FieldError": {
        "description": "Un campo del cuerpo que incumple el contrato.",
        "properties": {
          "field": {
            "examples": [
              "features.alcohol"
            ],
            "title": "Field",
            "type": "string"
          },
          "message": {
            "examples": [
              "Input should be a valid number"
            ],
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "field",
          "message"
        ],
        "title": "FieldError",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Estado del servicio y del modelo cargado.",
        "properties": {
          "model_status": {
            "const": "ready",
            "title": "Model Status",
            "type": "string"
          },
          "model_version": {
            "title": "Model Version",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "model_status",
          "model_version",
          "request_id"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "Prediction": {
        "description": "Predicción pública: no incluye puntuaciones internas del modelo.",
        "properties": {
          "confidence": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "model_version": {
            "title": "Model Version",
            "type": "string"
          },
          "preprocessing_version": {
            "title": "Preprocessing Version",
            "type": "string"
          },
          "quality_band": {
            "$ref": "#/components/schemas/QualityBand"
          }
        },
        "required": [
          "quality_band",
          "confidence",
          "model_version",
          "preprocessing_version"
        ],
        "title": "Prediction",
        "type": "object"
      },
      "PredictionRequest": {
        "additionalProperties": false,
        "description": "Cuerpo de `POST /v1/predictions`.",
        "properties": {
          "features": {
            "$ref": "#/components/schemas/WineFeatures"
          }
        },
        "required": [
          "features"
        ],
        "title": "PredictionRequest",
        "type": "object"
      },
      "PredictionResponse": {
        "description": "Respuesta de `POST /v1/predictions`.",
        "properties": {
          "prediction": {
            "$ref": "#/components/schemas/Prediction"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "served_at": {
            "format": "date-time",
            "title": "Served At",
            "type": "string"
          }
        },
        "required": [
          "prediction",
          "request_id",
          "served_at"
        ],
        "title": "PredictionResponse",
        "type": "object"
      },
      "QualityBand": {
        "description": "Bandas de calidad que entiende el consumidor.",
        "enum": [
          "needs_review",
          "acceptable",
          "excellent"
        ],
        "title": "QualityBand",
        "type": "string"
      },
      "WineFeatures": {
        "additionalProperties": false,
        "description": "Once variables fisicoquímicas de un vino tinto, con rangos inclusivos.",
        "properties": {
          "alcohol": {
            "description": "Alcohol (% vol.).",
            "maximum": 20.0,
            "minimum": 5.0,
            "title": "Alcohol",
            "type": "number"
          },
          "chlorides": {
            "description": "Chlorides (g/dm³).",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Chlorides",
            "type": "number"
          },
          "citric_acid": {
            "description": "Citric acid (g/dm³).",
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Citric Acid",
            "type": "number"
          },
          "density": {
            "description": "Density (g/cm³).",
            "maximum": 1.01,
            "minimum": 0.98,
            "title": "Density",
            "type": "number"
          },
          "fixed_acidity": {
            "description": "Fixed acidity (g/dm³).",
            "maximum": 20.0,
            "minimum": 0.0,
            "title": "Fixed Acidity",
            "type": "number"
          },
          "free_sulfur_dioxide": {
            "description": "Free sulfur dioxide (mg/dm³).",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Free Sulfur Dioxide",
            "type": "number"
          },
          "ph": {
            "description": "pH (unitless).",
            "maximum": 4.5,
            "minimum": 2.5,
            "title": "Ph",
            "type": "number"
          },
          "residual_sugar": {
            "description": "Residual sugar (g/dm³).",
            "maximum": 20.0,
            "minimum": 0.0,
            "title": "Residual Sugar",
            "type": "number"
          },
          "sulphates": {
            "description": "Sulphates (g/dm³).",
            "maximum": 3.0,
            "minimum": 0.0,
            "title": "Sulphates",
            "type": "number"
          },
          "total_sulfur_dioxide": {
            "description": "Total sulfur dioxide (mg/dm³).",
            "maximum": 300.0,
            "minimum": 0.0,
            "title": "Total Sulfur Dioxide",
            "type": "number"
          },
          "volatile_acidity": {
            "description": "Volatile acidity (g/dm³).",
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Volatile Acidity",
            "type": "number"
          }
        },
        "required": [
          "fixed_acidity",
          "volatile_acidity",
          "citric_acid",
          "residual_sugar",
          "chlorides",
          "free_sulfur_dioxide",
          "total_sulfur_dioxide",
          "density",
          "ph",
          "sulphates",
          "alcohol"
        ],
        "title": "WineFeatures",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "API que predice la calidad del vino a partir de 11 caracteristicas \n\nCada preticion tiene un 'request_id' para poder identificarla. \n\nLos errores utilizan un sobre común con `code`, `message`, `fields` y `request_id`.",
    "summary": "API para predecir la calidad del vino",
    "title": "Wine Quality API",
    "version": "1.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Comprueba si el servicio está funcionando y el modelo está disponible.\n\nEste endpoint se utiliza para consultar el estado de la API.\nSi el modelo no está cargado, devuelve un error HTTP 503.",
        "operationId": "read_health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Service and model status"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Prediction model is unavailable"
          }
        },
        "summary": "Check service health",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/predictions": {
      "post": {
        "description": "Predice la calidad de un vino a partir de 11 características.\n\nLas variables deben cumplir los rangos definidos en WineFeatures.\nDevuelve la clasificación, la confianza con dos decimales\ny las versiones del modelo y del preprocesamiento.",
        "operationId": "create_prediction_v1_predictions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "examples": {
                "invalid_alcohol": {
                  "summary": "Alcohol out of range",
                  "value": {
                    "features": {
                      "alcohol": 30,
                      "chlorides": 0.076,
                      "citric_acid": 0.0,
                      "density": 0.9978,
                      "fixed_acidity": 7.4,
                      "free_sulfur_dioxide": 11.0,
                      "ph": 3.51,
                      "residual_sugar": 1.9,
                      "sulphates": 0.56,
                      "total_sulfur_dioxide": 34.0,
                      "volatile_acidity": 0.7
                    }
                  }
                },
                "missing_alcohol": {
                  "summary": "Missing alcohol",
                  "value": {
                    "features": {
                      "chlorides": 0.076,
                      "citric_acid": 0.0,
                      "density": 0.9978,
                      "fixed_acidity": 7.4,
                      "free_sulfur_dioxide": 11.0,
                      "ph": 3.51,
                      "residual_sugar": 1.9,
                      "sulphates": 0.56,
                      "total_sulfur_dioxide": 34.0,
                      "volatile_acidity": 0.7
                    }
                  }
                },
                "valid": {
                  "summary": "Valid wine",
                  "value": {
                    "features": {
                      "alcohol": 9.4,
                      "chlorides": 0.076,
                      "citric_acid": 0.0,
                      "density": 0.9978,
                      "fixed_acidity": 7.4,
                      "free_sulfur_dioxide": 11.0,
                      "ph": 3.51,
                      "residual_sugar": 1.9,
                      "sulphates": 0.56,
                      "total_sulfur_dioxide": 34.0,
                      "volatile_acidity": 0.7
                    }
                  }
                }
              },
              "schema": {
                "$ref": "#/components/schemas/PredictionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictionResponse"
                }
              }
            },
            "description": "Wine quality prediction with confidence and model versions"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid JSON"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Validation error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Prediction model unavailable"
          }
        },
        "summary": "Predict wine quality",
        "tags": [
          "predictions"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "comprueba el estado del servicio y del modelo",
      "name": "health"
    },
    {
      "description": "Permite realizar predicciones de calidad del vino",
      "name": "predictions"
    }
  ]
}
